{
  "name": "nullianity-wiki",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "https://github.com/NullianityWiki/mkdocs-wiki.git",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "run": "mkdocs serve",
    "build": "npx tdl-install-types && tsc",
    "report": "npx tsx src/report/report.ts",
    "report-thread": "npx tsx src/report/report-thread.ts",
    "export-thread": "npx tsx src/export/export-thread.ts",
    "export-chat": "npx tsx src/export/export-chat.ts",
    "analize": "npx tsx src/analyze/analize.ts && npx tsx src/wiki/add-lore.ts",
    "analize-chat": "npx tsx src/analyze/analyze-chat.ts",
    "analyze-github": "npx tsx src/analyze/analyze-github.ts",
    "add-lore": "npx tsx src/wiki/add-lore.ts",
    "moderation": "npx tsx src/moderation/moderation.ts",
    "moderation-strict": "npx tsx src/moderation/moderation-strict.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.14",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.10.0",
    "@octokit/core": "^7.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/stream-chain": "^2.1.0",
    "@types/stream-json": "^1.7.8",
    "axios": "^1.10.0",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.5.0",
    "minimatch": "^10.0.3",
    "openai": "^5.8.2",
    "prebuilt-tdlib": "^0.1008050.0",
    "stream-json": "^1.9.1",
    "tdl": "^8.0.2",
    "tdl-install-types": "0.3.0",
    "tiktoken": "^1.0.21",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.4"
  },
  "engines": {
    "node": ">=22"
  }
}
